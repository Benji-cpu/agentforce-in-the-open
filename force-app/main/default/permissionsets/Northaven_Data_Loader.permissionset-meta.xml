<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Northaven Data Loader</label>
    <description>Edit access to the custom Order fields, for whoever loads the synthetic dataset. Metadata deploys do not grant field-level security to the deploying user's profile, so without this the tree import writes nothing into the new fields.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <fieldPermissions><editable>true</editable><field>Order.Order_Reference__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Order.Fulfilment_Status__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Order.Carrier__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Order.Tracking_Number__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Order.Expected_Delivery__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Order.Items_Summary__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Order.Calibration_Certificate__c</field><readable>true</readable></fieldPermissions>
</PermissionSet>
